CHAIN_A_RPC=http://127.0.0.1:8545
CHAIN_B_RPC=http://127.0.0.1:9545
RUNTIME_MODE=besu
PROOF_POLICY=storage-required
USE_BESU_KEYS=true
DEMO_UI_PORT=5173

DEMO_FORWARD_AMOUNT=100
DEMO_BORROW_AMOUNT=120
DEMO_SHOCKED_VOUCHER_PRICE=0.5
DEMO_LIQUIDATION_REPAY=40

# Demo allowance used by approveIfNeeded to avoid repeated approval transactions.
DEMO_APPROVAL_ALLOWANCE=1000000
DEMO_PACKET_TIMEOUT_HEIGHT=1000000
DEMO_MAX_TIMEOUT_HEADER_GAP=600

# Cached deployment-health check TTL for smoother UI actions.
DEMO_PREPARED_CONTEXT_HEALTH_TTL_MS=30000

# Transaction/read retry tuning for local Besu demo reliability.
DEMO_TX_WAIT_TIMEOUT_MS=120000
DEMO_READ_RETRY_ATTEMPTS=4
DEMO_READ_RETRY_DELAY_MS=250

DEMO_LIGHT_CLIENT_HEARTBEAT=true
DEMO_LIGHT_CLIENT_HEARTBEAT_INTERVAL_MS=10000
DEMO_LIGHT_CLIENT_HEARTBEAT_MAX_HEADERS=60
DEMO_RESUME_MAX_HEADERS=60
DEMO_RESUME_MAX_HEADER_GAP=1200
