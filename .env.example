# Local two-chain runtime
CHAIN_A_RPC=http://127.0.0.1:8545
CHAIN_B_RPC=http://127.0.0.1:9545
RUNTIME_MODE=besu
PROOF_POLICY=storage-required
USE_BESU_KEYS=true

# Besu network generation and Docker lifecycle
BESU_NETWORK_ROOT=networks/besu
BESU_COMPOSE_FILE=networks/besu/docker-compose.yml
BESU_COMPOSE_PROJECT_NAME=thesis-besu
BESU_CONTAINER_PREFIX=thesis
BESU_DOCKER_IMAGE=hyperledger/besu:26.8.1@sha256:6f3f21ce533383fcc8db3bce02252b59d5a9e776b72b5a1c8ecd2db011600042
BESU_JAVA_OPTS=-Xms128m -Xmx512m -XX:ActiveProcessorCount=2
BESU_VALIDATOR_COUNT=4
BESU_CHAIN_A_RPC_PORT=8545
BESU_CHAIN_B_RPC_PORT=9545
BESU_SUBNET_SECOND_OCTET=30
BESU_QBFT_BLOCK_PERIOD_SECONDS=2
BESU_QBFT_REQUEST_TIMEOUT_SECONDS=10
BESU_BONSAI_HISTORICAL_BLOCK_LIMIT=100000
BESU_BONSAI_TRIE_LOGS_PRUNING_WINDOW_SIZE=120000
UNSAFE_LOCAL_DEMO=false
BESU_ENABLE_ADMIN_DEBUG=false

# Besu readiness, RPC and bounded retries
BESU_HEALTH_TIMEOUT_MS=45000
BESU_HEALTH_PROGRESS_BLOCKS=1
BESU_START_AUTO_RECOVER=true
BESU_START_PROGRESS_TIMEOUT_MS=60000
BESU_START_PROGRESS_BLOCKS=1
RPC_WAIT_TIMEOUT_MS=300000
RPC_REQUEST_TIMEOUT_MS=5000
BLOCK_WAIT_TIMEOUT_MS=300000
BESU_TX_SEND_RETRIES=2
BESU_READ_RETRIES=8
BESU_READ_RETRY_MS=500
BESU_CODE_READ_RETRIES=8
BESU_CODE_READ_RETRY_MS=500
BESU_BLOCK_READ_RETRIES=8
BESU_BLOCK_READ_RETRY_MS=500

# Institutional deployment and governance profile
INSTITUTIONAL_DEPLOYMENT_PATH=.runtime/institutional-deployment.json
INSTITUTIONAL_ATTESTOR_SECRETS_PATH=.runtime/institutional-attestor-secrets.json
INSTITUTIONAL_DEPLOY_GAS_LIMIT=10000000
INSTITUTIONAL_TX_GAS_LIMIT=5000000
INSTITUTIONAL_TX_TIMEOUT_MS=90000
INSTITUTIONAL_FLOW_TIMEOUT_MS=180000
INSTITUTIONAL_FINALITY_DEPTH=2
INSTITUTIONAL_MAX_CHECKPOINT_SUBMISSION_AGE_SECONDS=604800
INSTITUTIONAL_MAX_CLOCK_DRIFT_SECONDS=30
INSTITUTIONAL_GOVERNANCE_DELAY_SECONDS=60

# Embedded demo runtime and semantic-readiness state
INSTITUTIONAL_DEMO_ROOT=.runtime/institutional-demo
INSTITUTIONAL_DEMO_STATE_PATH=.runtime/institutional-demo-state.json
INSTITUTIONAL_DEMO_MIN_LIQUIDITY=100000
INSTITUTIONAL_DEMO_RELAY_POLL_MS=1000
INSTITUTIONAL_ACTION_RECOVERY_POLL_MS=2000
INSTITUTIONAL_ACTION_RECOVERY_MAX_POLL_MS=60000

# Browser UI and doctor
DEMO_UI_PORT=5173
DEMO_UI_URL=http://127.0.0.1:5173
DEMO_UI_PREFLIGHT=true
DEMO_UI_PREFLIGHT_TIMEOUT_MS=90000
DEMO_DOCTOR_PROGRESS_TIMEOUT_MS=20000

# Integration, benchmark and validator-availability reports
INSTITUTIONAL_INTEGRATION_REPORT_PATH=.runtime/institutional-integration-report.json
INSTITUTIONAL_SECURITY_REPORT_PATH=.runtime/evidence/security-scenarios.json
BESU_QBFT_FAULT_REPORT_PATH=.runtime/besu-qbft-fault-report.json
BESU_FAULT_STOP_TIMEOUT_MS=60000
INSTITUTIONAL_BENCHMARK_MESSAGES=3
INSTITUTIONAL_BENCHMARK_REQUIRED_SAMPLES=100
INSTITUTIONAL_BENCHMARK_TARGET_P95_MS=45000
INSTITUTIONAL_ENFORCE_BENCHMARK=false

# Optional standalone relay/attestor service configuration files
INSTITUTIONAL_RELAY_CONFIG=config/institutional-relay.json
INSTITUTIONAL_ATTESTOR_CONFIG=config/institutional-attestor.json

# Diagnostic switches; keep disabled for ordinary runs
DEBUG_BESU_TX_RETRY=false
LOG_NONCES=false

# Compatibility aliases are intentionally not set:
# DEMO_BESU_VALIDATOR_COUNT -> BESU_VALIDATOR_COUNT
# TX_SEND_RETRIES -> BESU_TX_SEND_RETRIES
